+// dynamic variable runs, not at load, so loading never fails; a variable
+// whose faker method no longer exists throws when it is used.
+var fakerModule = require('@faker-js/faker/locale/en'),
+    realFaker = fakerModule.faker || fakerModule,
+    faker = new Proxy({}, {
+        get: function (_, namespace) {
+            return new Proxy({}, {
+                get: function (__, method) {
+                    return function () {
+                        var ns = realFaker[namespace],
+                            fn = ns && ns[method];
+
+                        if (typeof fn !== 'function') {
+                            throw new Error('faker.' + String(namespace) + '.' + String(method) + ' is not available');
+                        }
+
+                        return fn.apply(ns, arguments);
+                    };
+                }
+            });
+        }
+    }),
