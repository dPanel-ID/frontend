# Used by `pnpm dev:mock`. API calls go to the Prism mock API on port 4010
# (see scripts/mock/dev-mock.mjs). Prism allows this origin with credentials.
BASE_PATH="/"
VITE_ENVIRONMENT="mock"
VITE_FRONTEND="http://localhost:3000"
VITE_BACKEND="http://127.0.0.1:4010/api"
VITE_SECURE_SHELL_HOST="http://localhost:3000/mock-unavailable/secure-shell/"
VITE_DB_MANAGER_HOST="http://localhost:3000/mock-unavailable/db-manager/"
VITE_GITHUB_APP_URL="https://github.com/apps/dnocs-id"
