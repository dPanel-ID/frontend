# A template for `.env.local` (gitignored), which overrides the mode's own
# file: `.env.development` for `pnpm dev`, `.env.mock` for `pnpm dev:mock`.
# Copy only the lines you want to change, for example to point `pnpm dev` at
# another dPanel API.
BASE_PATH="/"
VITE_ENVIRONMENT="development"
VITE_FRONTEND="http://localhost:3000"
VITE_BACKEND="https://your-api.example.com/api"
VITE_SECURE_SHELL_HOST="https://secureshell.example.com/"
VITE_DB_MANAGER_HOST="https://dbmanager.example.com/"
VITE_GITHUB_APP_URL="https://github.com/apps/dnocs-id"
