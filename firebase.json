{
  "hosting": {
    "public": ".output-static/client",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**", "_redirects"],
    "cleanUrls": true,
    "trailingSlash": false,
    "redirects": [
      {
        "source": "/docs",
        "destination": "/docs/intro",
        "type": 301
      }
    ],
    "rewrites": [
      {
        "source": "!{/assets/**,/docs/**}",
        "destination": "/app-shell.html"
      }
    ]
  }
}
